{
  "name": "pi-herdr-subagents-lite",
  "version": "0.5.0",
  "description": "Run pi subagents in herdr panes.",
  "type": "module",
  "license": "MIT",
  "author": "setwhite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/setwhite/pi-herdr-subagents-lite.git"
  },
  "keywords": ["pi-package", "pi-extension", "herdr", "subagent"],
  "files": ["src"],
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "check:imports": "node scripts/check-imports.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm lint && pnpm check:imports && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
